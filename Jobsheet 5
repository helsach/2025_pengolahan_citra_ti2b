        "axes[2].imshow(image3); axes[2].set_title('Image 3 (Same)'); axes[2].axis('off')\n",
        "axes[3].imshow(image4); axes[3].set_title('Image 4 (Downsampled)'); axes[3].axis('off')\n",
        "plt.show()"
      ]
