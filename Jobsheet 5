        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from skimage import data\n",
        "from skimage.feature import match_template\n",
        "from skimage.transform import rotate, rescale\n",
        "\n",
        "# Muat citra target dan template\n",
        "image = data.coins()\n",
        "template = image[15:80, 190:260]  # potong satu koin sebagai template\n",
        "h, w = template.shape\n",
        "\n",
        "# ======= 1. Matching Template Asli =======\n",
        "result_orig = match_template(image, template)\n",
        "ij_orig = np.unravel_index(np.argmax(result_orig), result_orig.shape)\n",
        "x_orig, y_orig = ij_orig[::-1]  # (x, y) sudut kiri atas\n",
        "\n",
        "# ======= 2. Matching Template yang Dirotasi =======\n",
        "rotated_template = rotate(template, angle=45, resize=True)\n",
        "result_rot = match_template(image, rotated_template)\n",
        "ij_rot = np.unravel_index(np.argmax(result_rot), result_rot.shape)\n",
        "x_rot, y_rot = ij_rot[::-1]\n",
        "h_rot, w_rot = rotated_template.shape\n",
        "\n",
        "# ======= 3. Matching Template yang Diskalakan =======\n",
        "scaled_template = rescale(template, scale=1.5, anti_aliasing=True)\n",
        "result_scale = match_template(image, scaled_template)\n",
        "ij_scale = np.unravel_index(np.argmax(result_scale), result_scale.shape)\n",
        "x_scale, y_scale = ij_scale[::-1]\n",
        "h_scale, w_scale = scaled_template.shape\n",
        "\n",
        "# ======= Visualisasi Semua Hasil =======\n",
        "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
        "\n",
        "# Template asli\n",
        "axes[0].imshow(image, cmap='gray')\n",
        "axes[0].add_patch(plt.Rectangle((x_orig, y_orig), w, h, edgecolor='r', facecolor='none', lw=2))\n",
        "axes[0].set_title('Matching: Template Asli')\n",
        "axes[0].axis('off')\n",
        "\n",
        "# Template rotasi\n",
        "axes[1].imshow(image, cmap='gray')\n",
        "axes[1].add_patch(plt.Rectangle((x_rot, y_rot), w_rot, h_rot, edgecolor='orange', facecolor='none', lw=2))\n",
        "axes[1].set_title('Matching: Template Rotasi 45°')\n",
        "axes[1].axis('off')\n",
        "\n",
        "# Template skala\n",
        "axes[2].imshow(image, cmap='gray')\n",
        "axes[2].add_patch(plt.Rectangle((x_scale, y_scale), w_scale, h_scale, edgecolor='blue', facecolor='none', lw=2))\n",
        "axes[2].set_title('Matching: Template Diperbesar 1.5x')\n",
        "axes[2].axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Cetak koordinat dan skor similarity tertinggi\n",
        "print(f\"Template Asli ditemukan di (x,y): ({x_orig}, {y_orig}) | Skor: {np.max(result_orig):.4f}\")\n",
        "print(f\"Template Rotasi ditemukan di (x,y): ({x_rot}, {y_rot}) | Skor: {np.max(result_rot):.4f}\")\n",
        "print(f\"Template Skala ditemukan di (x,y): ({x_scale}, {y_scale}) | Skor: {np.max(result_scale):.4f}\")\n"
      ]
